amrex.use_gpu_aware_mpi=1

########################################################################
# Spin-transfer-torque (STT) switching of a perpendicular
# CoFeB / MgO / CoFeB magnetic tunnel junction (MTJ) nanopillar
#
#    z
#    ^   free layer       CoFeB  1 nm   2 nm < z < 3 nm   starts along -z, is switched
#    |   tunnel barrier   MgO    1 nm   1 nm < z < 2 nm   non-magnetic (Ms = 0)
#    |   reference layer  CoFeB  1 nm   0 nm < z < 1 nm   fixed along +z
#
# The pillar is a cylinder with a 40 nm diameter, centered on x = y = 0.
#
# The free layer starts antiparallel (AP) to the reference layer, tilted by
# 5 degrees so that the torque is non-zero at t = 0 (there is no thermal
# noise).  A 1.5 ns current pulse with J > 0 (electrons flow from the reference
# layer into the free layer) switches it to the parallel (P) state within
# about 1.2 ns, and it stays there after the pulse ends.
#
# Diagnostics.txt lists <mx> <my> <mz> averaged over BOTH magnetic layers,
# so <mz> goes from ~0 (AP) to ~1 (P).
########################################################################

# 1 nm cubic cells (the demag solver needs dx = dy = dz)
n_cell = 40 40 3
max_grid_size_x = 40
max_grid_size_y = 40
max_grid_size_z = 3

prob_lo = -20.e-9 -20.e-9 0.
prob_hi =  20.e-9  20.e-9 3.e-9

dt = 2.5e-14
nsteps = 80000    # 2 ns

plot_int = 4000    # every 0.1 ns
chk_int = -1
restart = -1
diag_type = 3      # writes the averaged magnetization to Diagnostics.txt every step

mu0 = 1.25663706212e-6

########################################################################
# geometry and materials
#   pillar:           (x*x+y*y < 4.e-16)     radius 20 nm
#   reference layer:  (z>0.)*(z<1.e-9)
#   free layer:       (z>2.e-9)*(z<3.e-9)
# The MgO barrier is simply the gap between the two layers where Ms = 0.
# Keep Ms = 0 outside the domain as well (as the z limits above do), because
# that is how the exchange boundary condition finds the surfaces.
########################################################################

# CoFeB saturation magnetization [A/m] in both magnetic layers
Ms_parser(x,y,z) = "1.2e6 * (x*x+y*y < 4.e-16) * ( (z>0.)*(z<1.e-9) + (z>2.e-9)*(z<3.e-9) )"

# reference layer along +z; free layer 5 degrees away from -z, tilted towards +x
#   sin(5 deg) = 0.08716, cos(5 deg) = 0.99619
Mx_parser(x,y,z) = "1.2e6 * (x*x+y*y < 4.e-16) * 0.08716 * (z>2.e-9)*(z<3.e-9)"
My_parser(x,y,z) = "0."
Mz_parser(x,y,z) = "1.2e6 * (x*x+y*y < 4.e-16) * ( (z>0.)*(z<1.e-9) - 0.99619 * (z>2.e-9)*(z<3.e-9) )"

timedependent_Hbias = 0
Hx_bias_parser(x,y,z,t) = "0."
Hy_bias_parser(x,y,z,t) = "0."
Hz_bias_parser(x,y,z,t) = "0."

timedependent_alpha = 0
alpha_parser(x,y,z,t) = "0.02"
gamma_parser(x,y,z) = "-1.759e11"
exchange_parser(x,y,z) = "1.3e-11"

# perpendicular (interfacial CoFeB/MgO) anisotropy, written as a volume anisotropy [J/m^3]
#   free layer:      1.1e6  (1.1 mJ/m^2 over 1 nm)
#   reference layer: 2.0e6, made stiffer to stand in for the pinning of a real reference layer
anisotropy_parser(x,y,z) = "1.1e6 * (z>2.e-9) + 2.0e6 * (z<1.e-9)"
DMI_parser(x,y,z) = "0."

precession = 1
demag_coupling = 1
FFT_solver = 1
M_normalization = 1  # 0 = unsaturated case; 1 = saturated case
exchange_coupling = 1
anisotropy_coupling = 1
anisotropy_axis = 0.0 0.0 1.0
DMI_coupling = 0

########################################################################
# spin-transfer torque
#
#   dm/dt = -mu0 |gamma| m x ( H_eff + H_STT_DL + H_STT_TL ) + alpha m x dm/dt
#
#   H_STT_DL = a_J (m x p)   damping-like torque,   a_J = beta * epsilon
#   H_STT_TL = b_J  p        field-like torque,     b_J = beta * epsilon'
#
#   beta    = hbar J / (mu0 e Ms d)                               [A/m]
#   epsilon = P Lambda^2 / ( (Lambda^2+1) + (Lambda^2-1) (m.p) )  (= P/2 for Lambda = 1)
#
# (same convention as OOMMF's Oxs_SpinXferEvolve and MuMax3)
########################################################################

# flags that turn the two STT terms on (1) and off (0) independently
STT_DL_coupling = 1    # damping-like term, H_STT_DL
STT_TL_coupling = 1    # field-like term,   H_STT_TL

# current density J [A/m^2]; it is also the mask that selects where the STT acts,
# here the free layer only.  J > 0: electrons flow from the reference layer into the
# free layer and pull m towards p (favors P);  J < 0 favors AP.
# 2.e11 A/m^2 = 20 MA/cm^2, switched on for the first 1.5 ns
timedependent_J_STT = 1
J_STT_parser(x,y,z,t) = "2.e11 * (z>2.e-9) * (t<1.5e-9)"

# p: direction of the reference layer magnetization (normalized by the code)
STT_polarization_axis = 0.0 0.0 1.0

# d: thickness of the free layer [m]
STT_free_layer_thickness = 1.e-9

# P: spin polarization, and Lambda: Slonczewski asymmetry parameter
# (Lambda = 1 gives a plain sin(theta) angular dependence, a common choice for a tunnel barrier)
STT_polarization = 0.6
STT_Lambda = 1.0

# epsilon': strength of the field-like term; b_J/a_J = 2 epsilon'/P = 0.2 here
STT_epsilon_prime = 0.06

# plotfile output of Hx/Hy/Hz_STT_DL and Hx/Hy/Hz_STT_TL (default 1)
plot_STT_DL = 1
plot_STT_TL = 1

########################################################################
# INTEGRATION
########################################################################
#TimeIntegratorOption = 1 #Forward Euler
TimeIntegratorOption = 2 #Predictor-corrector
#TimeIntegratorOption = 3 #2nd order artemis way
#TimeIntegratorOption = 4 #amrex/sundials backend integrators

# tolerance threshold (L_inf change between iterations) for TimeIntegrationOption 2 and 3
iterative_tolerance = 1.e-9

# for TimeIntegratorOption = 4, integration.type can take on the following values:
## 0 or "ForwardEuler" => Native AMReX Forward Euler integrator
## 1 or "RungeKutta"   => Native AMReX Explicit Runge Kutta controlled by integration.rk.type
## 2 or "SUNDIALS"     => SUNDIALS backend controlled by integration.sundials.type
integration.type = RungeKutta

## for integration.type = RungeKutta, integration.rk.type can take the following values:
### 0 = User-specified Butcher Tableau
### 1 = Forward Euler
### 2 = Trapezoid Method
### 3 = SSPRK3 Method
### 4 = RK4 Method
integration.rk.type = 4

## for integration.type = SUNDIALS, set the SUNDIALS method type:
# ERK      = Explicit Runge-Kutta method
# DIRK     = Diagonally Implicit Runge-Kutta method
# IMEX-RK  = Implicit-Explicit Additive Runge-Kutta method
# EX-MRI   = Explicit Multirate Infinitesimal method
# IM-MRI   = Implicit Multirate Infinitesimal method
# IMEX-MRI = Implicit-Explicit Multirate Infinitesimal method
integration.sundials.type = ERK

# for the MRI and IMEX-RK types the STT terms are in the slow / explicit partition
# unless fast_STT = 1 / implicit_STT = 1 is set
